{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--browser", "chromium",
        "--executable-path", "/opt/pw-browsers/chromium"
      ]
    },
    "perplexity": {
      "type": "http",
      "url": "https://api.perplexity.ai/mcp"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    }
  }
}
